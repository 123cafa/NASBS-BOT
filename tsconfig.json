{
    "compilerOptions": {
        "outDir": "./built",
        "rootDir": "./src",
        "target": "ES2022",
        "module": "NodeNext",
        "skipLibCheck": true,
        "moduleResolution": "NodeNext",
        "esModuleInterop": true
    },
    "include": [
        "./src/**/*"
    ],
    "ts-node": {
        "skipIgnore": true,
        "transpileOnly": true
    }
}